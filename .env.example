# Application
APP_ENV=development
APP_NAME=Agentic RAG
API_HOST=0.0.0.0
API_PORT=8000

# Database (local Docker Compose defaults; change before production)
POSTGRES_DB=agentic_rag
POSTGRES_USER=agentic_rag_app
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+psycopg://agentic_rag_app:change_me_local_only@localhost:5432/agentic_rag

# Authentication (generate a unique random secret of at least 32 characters)
# Example: py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET
JWT_ACCESS_TOKEN_MINUTES=30

# Optional n8n orchestration (import n8n/workflows/agentic-rag-ollama.json; leave URL blank to use direct Ollama RAG)
# Use the production webhook URL, not the n8n test URL.
N8N_CHAT_WEBHOOK_URL=
# Generate a unique random secret of at least 32 characters; configure the same value in n8n.
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_SECONDS=90

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# File storage (generate a unique key; do not commit the real .env)
FILE_ENCRYPTION_KEY=REPLACE_WITH_URLSAFE_BASE64_32_BYTE_KEY
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed
MAX_UPLOAD_SIZE_MB=20

# OCR is opt-in because PaddleOCR increases image size, install time, RAM use, and CPU latency.
INSTALL_OCR=false

# Frontend CORS
CORS_ORIGINS=http://localhost:5173

# Document ingestion
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
